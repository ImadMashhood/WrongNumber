# Use these ONLY in the separate trusted wrong-number-caller-server process.
# Do not put real credentials in this file or in any client.
# A key without CALLER_MODEL does not enable paid requests.
CALLER_BIND=127.0.0.1:47005
CALLER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
CALLER_MODEL=
CALLER_API_KEY=
CALLER_MAX_REQUESTS=100

# Maximum provider token prices in USD per million; defaults are 1 each.
# Increase explicitly for the chosen model (e.g. GPT-4o needs higher limits).
CALLER_MAX_INPUT_PRICE=1
CALLER_MAX_OUTPUT_PRICE=1
